{% extends '@MarkocupicContaoSchoolTest/backend/_print_base.html.twig' %}

{% block title %}Arbeitsblatt {{ test.title }}{% endblock %}

{% block style %}
    .toolbar label { display: flex; gap: 6px; align-items: center; cursor: pointer; }
    .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; border-bottom: 2px solid #111; padding-bottom: 8px; margin-bottom: 4px; }
    .who { min-width: 74mm; font-size: 13px; }
    .who div { display: flex; gap: 6px; align-items: flex-end; margin-bottom: 7px; }
    .who span.line { flex: 1; border-bottom: 1px solid #111; height: 16px; }
    .score { display: flex; gap: 10px; margin-top: 8px; }
    .score div { border: 1.5px solid #111; border-radius: 4px; padding: 3px 8px 14px; font-size: 11px; min-width: 30mm; }
    ol.ws { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 8mm; }
    ol.ws > li { display: flex; gap: 8px; padding: 6px 0 9px; border-bottom: 1px dotted #bbb; break-inside: avoid; page-break-inside: avoid; }
    ol.ws > li.wide { grid-column: 1 / -1; }
    ol.ws .nr { font-weight: 700; min-width: 20px; }
    ol.ws .body { flex: 1; }
    ol.ws .q { margin-bottom: 4px; }
    ol.ws .pt { color: #555; font-size: 11px; white-space: nowrap; }
    ol.ws li:not(.wide) .body { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
    ol.ws li:not(.wide) .q { margin: 0; }
    .ans { display: inline-flex; align-items: center; gap: 4px; margin: 2px 14px 2px 0; white-space: nowrap; }
    .box { display: inline-block; width: 26mm; height: 8mm; border: 1px solid #444; border-radius: 2px; background: #fff; }
    .box.sm { width: 11mm; }
    .box.wide { width: 40mm; }
    .box.xwide { width: 70mm; }
    .stack { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; }
    .stack .box { height: 7mm; }
    .stack .bar { width: 13mm; border-top: 1.5px solid #111; }
    .fig { margin: 4px 0; }
    .fig svg.st-angsvg { width: 105mm; height: auto; }
    .fig svg.st-areasvg { width: 85mm; height: auto; }
    .fig svg.st-binfig { max-width: 110mm; height: auto; }
    .fig.sym svg { width: 62mm; height: auto; }
    .fig svg.geo { max-width: 100%; }
    .fields { display: flex; flex-wrap: wrap; }
    .trow { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 5px 0; }
    .tag { font-size: 11px; color: #555; border: 1px solid #aaa; border-radius: 8px; padding: 0 6px; }
    .choice { display: inline-flex; align-items: center; gap: 5px; }
    .tick { display: inline-block; width: 4mm; height: 4mm; border: 1px solid #444; margin-left: 6px; }
    table.kreuz { border-collapse: collapse; margin: 4px 0; }
    table.kreuz td { border: 1.5px solid #333; width: 15mm; height: 9mm; text-align: center; }
    table.pt td.in { height: 9mm; min-width: 20mm; text-align: right; vertical-align: bottom; font-size: 11px; color: #555; }
    .construct { border: 1px solid #bbb; border-radius: 3px; margin-top: 4px; max-width: 100%; }
    .solpage { display: none; }
    body.with-solutions .solpage { display: block; }
    table.sol { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    table.sol td { padding: 4px 6px; border-bottom: 1px dotted #bbb; vertical-align: top; }
    table.sol td.nr { width: 24px; font-weight: 700; }
    table.sol td.pt { width: 40px; text-align: right; color: #555; }
    .fig.sol svg.st-angsvg { width: 70mm; }
    .fig.sol svg.st-areasvg { width: 55mm; }
    .fig.sol svg.st-binfig { max-width: 70mm; }
    .fig.sym.sol svg { width: 40mm; }
    .note { font-size: 12px; color: #555; margin: 2px 0 0; }
    h2, .note { break-after: avoid; page-break-after: avoid; }
    @media print {
        body:not(.with-solutions) .page { break-after: auto; page-break-after: auto; }
        .head h1 { font-size: 20px; }
    }
{% endblock %}

{% block toolbar %}
    {{ test.title }} · Arbeitsblatt zum Hineinschreiben{% if not shared %} · ohne «Gleiche Aufgaben für alle»: bei jedem Öffnen neue Zufallsaufgaben, das Lösungsblatt passt zu diesem Blatt{% endif %}
    <label><input type="checkbox" onchange="document.body.classList.toggle('with-solutions', this.checked)"> Lösungsblatt mitdrucken</label>
{% endblock %}

{% block body %}
    <div class="page">
        <div class="head">
            <div>
                <h1>{{ test.title }}</h1>
                <p class="sub" style="margin:0">{{ test.subject }}{% if class %} · Klasse {{ class }}{% endif %}{% if test.timeLimit %} · Zeit {{ test.timeLimit }} Minuten{% endif %} · {{ max }} Punkte</p>
                <div class="score">
                    <div>Punkte</div>
                    <div>Note</div>
                </div>
            </div>
            <div class="who">
                <div>Name <span class="line"></span></div>
                <div>Datum <span class="line"></span></div>
            </div>
        </div>

        {% for sec in sections %}
            <h2><span class="letter">{{ loop.index0 < 26 ? 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[loop.index0:1] : loop.index }}</span>{{ sec.title }}<span class="pts">{{ sec.points }} P.</span></h2>
            <p class="note">{{ sec.instruction }}</p>
            <ol class="ws">
                {% for t in sec.tasks %}
                    <li class="{{ t.wide ? 'wide' : '' }}">
                        <span class="nr">{{ loop.index }}</span>
                        <div class="body"><div class="q">{{ t.q|raw }}</div>{{ t.blank|raw }}</div>
                        <span class="pt">{{ t.points }} P.</span>
                    </li>
                {% endfor %}
            </ol>
        {% endfor %}
    </div>

    <div class="page solpage">
        <h1>Lösungen: {{ test.title }}</h1>
        <p class="sub">{{ max }} Punkte · Note = 1 + 5 · Punkte / {{ pointsForSix }}</p>

        {% for sec in sections %}
            <h2><span class="letter">{{ loop.index0 < 26 ? 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[loop.index0:1] : loop.index }}</span>{{ sec.title }}<span class="pts">{{ sec.points }} P.</span></h2>
            <table class="sol">
                {% for t in sec.tasks %}
                    <tr><td class="nr">{{ loop.index }}</td><td>{{ t.solution|raw }}</td><td class="pt">{{ t.points }} P.</td></tr>
                {% endfor %}
            </table>
        {% endfor %}
    </div>
{% endblock %}

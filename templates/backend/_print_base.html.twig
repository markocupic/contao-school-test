<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}{% endblock %}</title>
    <style>
        @page { size: A4; margin: 14mm 14mm 16mm; }
        * { box-sizing: border-box; }
        body { margin: 0; font: 14px/1.45 "Segoe UI", Arial, sans-serif; color: #111; background: #e9ecf1; }
        .toolbar { position: sticky; top: 0; z-index: 2; display: flex; gap: 12px; align-items: center; padding: 10px 16px; background: #1d3f8f; color: #fff; }
        .toolbar button { font: inherit; font-weight: 600; padding: 7px 16px; border: 0; border-radius: 8px; background: #fff; color: #1d3f8f; cursor: pointer; }
        .toolbar span { opacity: .85; }
        .page { width: 210mm; min-height: 297mm; margin: 16px auto; padding: 14mm; background: #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, .15); }
        h1 { font-size: 22px; margin: 0 0 2px; }
        h2 { font-size: 17px; margin: 18px 0 6px; padding-bottom: 3px; border-bottom: 1.5px solid #111; display: flex; gap: 10px; align-items: baseline; }
        h2 .letter { background: #111; color: #fff; border-radius: 4px; padding: 0 7px; }
        h2 .pts { margin-left: auto; font-size: 13px; font-weight: 400; }
        .sub { color: #555; margin: 0 0 12px; }
        .fr { display: inline-flex; flex-direction: column; vertical-align: middle; text-align: center; line-height: 1.05; margin: 0 .12em; font-size: .92em; }
        .fr > span { padding: 0 .15em; }
        .fr .nu { border-bottom: .09em solid currentColor; }
        .mx { white-space: nowrap; }
        td b { white-space: nowrap; }
        svg.st-angsvg { display: block; width: 300px; height: auto; margin: 4px 0 2px; }
        .angans { font-size: 13px; }
        .angans s { color: #c33; }
        .angans .okv { color: #1a7f43; }
        .st-eq { white-space: nowrap; }
        svg.geo { display: block; margin: 4px 0 2px; max-width: 100%; height: auto; }
        .legend { font-size: 10px; color: #666; }
        table.tasks tr { break-inside: avoid; }
        table.pt { border-collapse: collapse; font-size: 13px; margin: 4px 0; }
        table.pt th, table.pt td { border: 1.5px solid #333; padding: 4px 6px; text-align: center; min-width: 58px; }
        table.pt th { background: #f2f2f2; text-align: left; font-weight: 400; white-space: nowrap; }
        table.pt td.ref { background: #e2e2e2; font-weight: 700; }
        table.pt td.ok { background: #e6f4ea; }
        table.pt td.bad { background: #fde8e7; line-height: 1.25; }
        table.pt td.bad s { color: #c33; }
        @media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .page { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; page-break-after: always; break-after: page; }
            .page:last-child { page-break-after: auto; break-after: auto; }
        }
        {% block style %}{% endblock %}
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">Drucken</button>
        <span>{% block toolbar %}{% endblock %}</span>
    </div>
    {% block body %}{% endblock %}
</body>
</html>
